       "<>", "\"\<}_{\\\\rm spin}^{(\\\\rm nuc)}\n  \\\\left(\n  \
\\\\ket{^{+}E}_{\\\\rm vib}\\\\ket{^{2}E}_{\\\\rm rot}\n  +(-1)^j\n  \
\\\\ket{^{-}E}_{\\\\rm vib}\\\\ket{^{1}E}_{\\\\rm rot}\n  \\\\right)\>\""}], ",", 
      RowBox[{
       RowBox[{"rot", "==", "\"\<E\>\""}], "&&", 

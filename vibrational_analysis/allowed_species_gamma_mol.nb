       RowBox[{"spin", "==", "\"\<E\>\""}], "&&", 
       RowBox[{"vib", "==", "\"\<E\>\""}]}], ",", 
      RowBox[{"\"\<\\\\frac{1}{\\\\sqrt{2}}\\\\ket{\>\"", "<>", 
       RowBox[{"TexIrrep", "[", "rot", "]"}], 
       "<>", "\"\<}_{\\\\rm rot}\n  \\\\left(\n  \\\\ket{^{1}E}_{\\\\rm \
spin}^{(\\\\rm nuc)}\\\\ket{^{-}E}_{\\\\rm vib}\n  +(-1)^j\n  \
\\\\ket{^{2}E}_{\\\\rm spin}^{(\\\\rm nuc)}\\\\ket{^{+}E}_{\\\\rm vib}\n  \
\\\\right)\>\""}], ",", 
      RowBox[{

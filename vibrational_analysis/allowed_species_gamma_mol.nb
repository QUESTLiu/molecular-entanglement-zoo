       "<>", "\"\<}_{\\\\rm vib}\n  \\\\left(\n  \\\\ket{^{1}E}_{\\\\rm \
spin}^{(\\\\rm nuc)}\\\\ket{^{2}E}_{\\\\rm rot}\n  +(-1)^j\n  \
\\\\ket{^{2}E}_{\\\\rm spin}^{(\\\\rm nuc)}\\\\ket{^{1}E}_{\\\\rm rot}\n  \
\\\\right)\>\""}], ",", 
      RowBox[{
       RowBox[{"rot", "==", "\"\<E\>\""}], "&&", 

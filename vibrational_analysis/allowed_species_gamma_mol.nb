      ",", "\"\<\\\\ket{A_2}_{\\\\rm rot}\\\\ket{A_2}_{\\\\rm spin}^{(\\\\rm \
nuc)}\\\\ket{A_2}_{\\\\rm vib}\>\"", ",", 
      RowBox[{
       RowBox[{"MemberQ", "[", 

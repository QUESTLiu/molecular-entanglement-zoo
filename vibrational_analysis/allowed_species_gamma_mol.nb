Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Needs", "[", "\"\<GroupTheory`\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"MakeTableData", ",", "DecomposeProduct", ",", "AllowedTriples"}],
     "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"MakeTableData", "[", 
     RowBox[{"pointGroup_", ",", "irrepLabels_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "g", ",", "raw", ",", "classes", ",", "chars", ",", "classSizes", ",", 
        "nChars", ",", "nLabels"}], "}"}], ",", 
      RowBox[{
       RowBox[{"g", "=", 
        RowBox[{"GTInstallGroup", "[", 
         RowBox[{"pointGroup", ",", 
          RowBox[{"GOVerbose", "->", "False"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"raw", "=", 
        RowBox[{"GTCharacterTable", "[", 
         RowBox[{"g", ",", 
          RowBox[{"GOIrepNotation", "->", "\"\<Mulliken\>\""}], ",", 
          RowBox[{"GOVerbose", "->", "False"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"classes", "=", 
        RowBox[{"raw", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"chars", "=", 
        RowBox[{"raw", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"classSizes", "=", 
        RowBox[{"Length", "/@", "classes"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"nChars", "=", 
        RowBox[{"Length", "[", "chars", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"nLabels", "=", 
        RowBox[{"Length", "[", "irrepLabels", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"nChars", "=!=", "nLabels"}], ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<Error: The point group \>\"", ",", "pointGroup", 
            ",", "\"\< has \>\"", ",", "nChars", 
            ",", "\"\< irreps, but you provided \>\"", ",", "nLabels", 
            ",", "\"\< labels.\>\""}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<PointGroup\>\"", "->", "pointGroup"}], ",", 
         RowBox[{"\"\<Labels\>\"", "->", "irrepLabels"}], ",", 
         RowBox[{"\"\<ClassSizes\>\"", "->", "classSizes"}], ",", 
         RowBox[{"\"\<Order\>\"", "->", 
          RowBox[{"Total", "[", "classSizes", "]"}]}], ",", 
         RowBox[{"\"\<Characters\>\"", "->", 
          RowBox[{"AssociationThread", "[", 
           RowBox[{"irrepLabels", "->", "chars"}], "]"}]}]}], "|>"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DecomposeProduct", "[", 
     RowBox[{"data_", ",", "reps_List"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "labels", ",", "chars", ",", "classSizes", ",", "order", ",", 
        "productChar", ",", "mults"}], "}"}], ",", 
      RowBox[{
       RowBox[{"labels", "=", 
        RowBox[{"data", "[", "\"\<Labels\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"chars", "=", 
        RowBox[{"data", "[", "\"\<Characters\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"classSizes", "=", 
        RowBox[{"data", "[", "\"\<ClassSizes\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"order", "=", 
        RowBox[{"data", "[", "\"\<Order\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"productChar", "=", 
        RowBox[{"Times", "@@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"chars", "[", "#", "]"}], "&"}], "/@", "reps"}], 
          ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"mults", "=", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{"labels", ",", 
          RowBox[{"Simplify", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Total", "[", 
               RowBox[{"classSizes", "*", 
                RowBox[{"Conjugate", "[", 
                 RowBox[{"chars", "[", "label", "]"}], "]"}], "*", 
                "productChar"}], "]"}], "/", "order"}], ",", 
             RowBox[{"{", 
              RowBox[{"label", ",", "labels"}], "}"}]}], "]"}], "]"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Select", "[", 
        RowBox[{"mults", ",", 
         RowBox[{
          RowBox[{"#", "!=", "0"}], "&"}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AllowedTriples", "[", 
    RowBox[{
    "data_", ",", "gammaRotList_", ",", "gammaNucList_", ",", "gammaVibList_",
      ",", "gammaMol_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "triples", ",", "rows", ",", "decomposition", ",", "multiplicity"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"triples", "=", 
       RowBox[{"Tuples", "[", 
        RowBox[{"{", 
         RowBox[{"gammaRotList", ",", "gammaNucList", ",", "gammaVibList"}], 
         "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rows", "=", 
       RowBox[{
        RowBox[{"Reap", "[", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"decomposition", "=", 
             RowBox[{"DecomposeProduct", "[", 
              RowBox[{"data", ",", "triple"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"multiplicity", "=", 
             RowBox[{"Lookup", "[", 
              RowBox[{"decomposition", ",", "gammaMol", ",", "0"}], "]"}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"multiplicity", ">", "0"}], ",", 
              RowBox[{"Sow", "[", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<Gamma_rot\>\"", "->", 
                  RowBox[{"triple", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], ",", 
                 RowBox[{"\"\<Gamma_nuc_spin\>\"", "->", 
                  RowBox[{"triple", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], ",", 
                 RowBox[{"\"\<Gamma_vib\>\"", "->", 
                  RowBox[{"triple", "[", 
                   RowBox[{"[", "3", "]"}], "]"}]}], ",", 
                 RowBox[{"\"\<Gamma_total\>\"", "->", "decomposition"}], ",", 
                 RowBox[{"\"\<Contains_Gamma_mol\>\"", "->", "True"}], ",", 
                 RowBox[{"\"\<Multiplicity\>\"", "->", "multiplicity"}]}], 
                "|>"}], "]"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"triple", ",", "triples"}], "}"}]}], "]"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"rows", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Dataset", "[", 
         RowBox[{"{", "}"}], "]"}], ",", 
        RowBox[{"Dataset", "[", 
         RowBox[{"First", "[", "rows", "]"}], "]"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"4788c67d-9ad1-e341-9773-db7641f6308e"],


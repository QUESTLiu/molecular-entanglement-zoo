        RowBox[{"phi", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"Sqrt", "[", "5", "]"}]}], ")"}], "/", "2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"psi", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"Sqrt", "[", "5", "]"}]}], ")"}], "/", "2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"labels", "=", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Ag\>\"", ",", "\"\<T1g\>\"", ",", "\"\<T2g\>\"", 
           ",", "\"\<Gg\>\"", ",", "\"\<Hg\>\"", ",", "\"\<Au\>\"", 
           ",", "\"\<T1u\>\"", ",", "\"\<T2u\>\"", ",", "\"\<Gu\>\"", 
           ",", "\"\<Hu\>\""}], "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Classes", ":", "E"}], ",", 
          RowBox[{"12", " ", "C5"}], ",", 
          RowBox[{"12", " ", 
           RowBox[{"C5", "^", "2"}]}], ",", 
          RowBox[{"20", " ", "C3"}], ",", 
          RowBox[{"15", " ", "C2"}], ",", "i", ",", 
          RowBox[{"12", " ", "iC5"}], ",", 
          RowBox[{"12", " ", 
           RowBox[{"iC5", "^", "2"}]}], ",", 
          RowBox[{"20", " ", "iC3"}], ",", 
          RowBox[{"15", " ", "iC2"}]}], "*)"}], 
        RowBox[{"classSizes", "=", 
         RowBox[{"{", 
          RowBox[{
          "1", ",", "12", ",", "12", ",", "20", ",", "15", ",", "1", ",", 
           "12", ",", "12", ",", "20", ",", "15"}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Rotational", " ", "icosahedral", " ", "group", " ", "I", " ", 
           RowBox[{"irreps", ":", "A"}]}], ",", "T1", ",", "T2", ",", "G", ",",
           "H"}], "*)"}], 
        RowBox[{"charsI", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", "phi", ",", "psi", ",", "0", ",", 
             RowBox[{"-", "1"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", "psi", ",", "phi", ",", "0", ",", 
             RowBox[{"-", "1"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", 
             RowBox[{"-", "1"}], ",", 
             RowBox[{"-", "1"}], ",", "1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"5", ",", "0", ",", "0", ",", 
             RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Ih", "=", 
           RowBox[{"I", " ", "x", " ", 
            RowBox[{"Ci", ".", "g"}], " ", "irreps", " ", "are", " ", "even", 
            " ", "under", " ", "inversion"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"u", " ", "irreps", " ", "are", " ", "odd", " ", "under", " ", 
           RowBox[{"inversion", "."}]}]}], "*)"}], 
        RowBox[{"charsIh", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"charsI", "[", 
                RowBox[{"[", "k", "]"}], "]"}], ",", 
               RowBox[{"charsI", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"Length", "[", "charsI", "]"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"charsI", "[", 
                RowBox[{"[", "k", "]"}], "]"}], ",", 
               RowBox[{"-", 
                RowBox[{"charsI", "[", 
                 RowBox[{"[", "k", "]"}], "]"}]}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"Length", "[", "charsI", "]"}]}], "}"}]}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<PointGroup\>\"", "->", "\"\<Ih\>\""}], ",", 
          RowBox[{"\"\<Labels\>\"", "->", "labels"}], ",", 
          RowBox[{"\"\<ClassSizes\>\"", "->", "classSizes"}], ",", 
          RowBox[{"\"\<Order\>\"", "->", 
           RowBox[{"Total", "[", "classSizes", "]"}]}], ",", 
          RowBox[{"\"\<Characters\>\"", "->", 
           RowBox[{"AssociationThread", "[", 
            RowBox[{"labels", "->", "charsIh"}], "]"}]}]}], "|>"}]}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"DecomposeProduct", "[", 
      RowBox[{"data_", ",", "reps_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "labels", ",", "chars", ",", "classSizes", ",", "order", ",", 
         "productChar", ",", "mults"}], "}"}], ",", 
       RowBox[{
        RowBox[{"labels", "=", 
         RowBox[{"data", "[", "\"\<Labels\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"chars", "=", 
         RowBox[{"data", "[", "\"\<Characters\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"classSizes", "=", 
         RowBox[{"data", "[", "\"\<ClassSizes\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"order", "=", 
         RowBox[{"data", "[", "\"\<Order\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"productChar", "=", 
         RowBox[{"Times", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"chars", "[", "#", "]"}], "&"}], "/@", "reps"}], 

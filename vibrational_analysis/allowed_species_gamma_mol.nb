        RowBox[{"mults", "=", 
         RowBox[{"AssociationThread", "[", 
          RowBox[{"labels", ",", 
           RowBox[{"Simplify", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"classSizes", "*", 
                 RowBox[{"Conjugate", "[", 
                  RowBox[{"chars", "[", "label", "]"}], "]"}], "*", 
                 "productChar"}], "]"}], "/", "order"}], ",", 
              RowBox[{"{", 
               RowBox[{"label", ",", "labels"}], "}"}]}], "]"}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Select", "[", 
         RowBox[{"mults", ",", 
          RowBox[{
           RowBox[{"#", "!=", "0"}], "&"}]}], "]"}]}]}], "]"}]}], ";"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"AllowedTriples", "[", 
      RowBox[{
      "data_", ",", "gammaRotList_", ",", "gammaNucList_", ",", 
       "gammaVibList_", ",", "gammaMol_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "triples", ",", "rows", ",", "decomposition", ",", "multiplicity"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"triples", "=", 
         RowBox[{"Tuples", "[", 
          RowBox[{"{", 
           RowBox[{"gammaRotList", ",", "gammaNucList", ",", "gammaVibList"}],
            "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rows", "=", 
         RowBox[{
          RowBox[{"Reap", "[", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"decomposition", "=", 
               RowBox[{"DecomposeProduct", "[", 
                RowBox[{"data", ",", "triple"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"multiplicity", "=", 
               RowBox[{"Lookup", "[", 
                RowBox[{"decomposition", ",", "gammaMol", ",", "0"}], "]"}]}],
               ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"multiplicity", ">", "0"}], ",", 
                RowBox[{"Sow", "[", 
                 RowBox[{"<|", 
                  RowBox[{
                   RowBox[{"\"\<Gamma_rot\>\"", "->", 
                    RowBox[{"triple", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ",", 
                   RowBox[{"\"\<Gamma_nuc_spin\>\"", "->", 
                    RowBox[{"triple", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ",", 
                   RowBox[{"\"\<Gamma_vib\>\"", "->", 
                    RowBox[{"triple", "[", 
                    RowBox[{"[", "3", "]"}], "]"}]}], ",", 
                   RowBox[{"\"\<Gamma_total\>\"", "->", "decomposition"}], ",", 
                   RowBox[{"\"\<Multiplicity\>\"", "->", "multiplicity"}]}], 
                  "|>"}], "]"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"triple", ",", "triples"}], "}"}]}], "]"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"rows", "===", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"Dataset", "[", 
           RowBox[{"{", "}"}], "]"}], ",", 
          RowBox[{"Dataset", "[", 
           RowBox[{"First", "[", "rows", "]"}], "]"}]}], "]"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",ExpressionUUID->"87fb41fc-2198-a74e-b174-\
